{
  "name": "hello-world",
  "version": "0.1.0",
  "private": true,
  "description": "Hello World: a real-time chat on a world map.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": ">=24.15"
  },
  "imports": {
    "#shared/*": "./src/shared/*"
  },
  "scripts": {
    "dev": "run-s db:up db:migrate dev:servers",
    "dev:servers": "run-p dev:api dev:web",
    "dev:api": "node --watch --env-file-if-exists=.env src/server/main.ts",
    "dev:web": "vite",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "node --env-file-if-exists=.env src/server/migrate.ts",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env src/server/main.ts",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --cache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "run-s db:up e2e",
    "e2e": "playwright test",
    "check:licenses": "node scripts/check-licenses.ts",
    "verify": "run-s db:up lint format:check type-check check:licenses test",
    "prepare": "husky"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@fastify/static": "10.1.8",
    "close-with-grace": "2.5.0",
    "fastify": "5.12.7",
    "kysely": "0.29.7",
    "mysql2": "3.24.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@mdi/js": "7.4.47",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.8",
    "@tsconfig/node24": "24.0.5",
    "@types/jsdom": "30.0.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.28",
    "@vue/devtools-api": "8.2.1",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "@vueuse/core": "15.0.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-vue": "10.12.0",
    "eslint-plugin-vuejs-accessibility": "2.6.3",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "jsdom": "30.1.3",
    "leaflet": "1.9.4",
    "npm-run-all2": "9.0.4",
    "pinia": "4.1.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "5.0.5",
    "vue": "3.5.44",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13",
    "vuetify": "4.3.1"
  }
}
