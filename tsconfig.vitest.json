// Unit and integration tests for both client and server code.
{
  "extends": "./tsconfig.app.json",
  "include": ["env.d.ts", "src/**/*.test.ts", "src/client/test/**/*", "src/server/test/**/*"],
  "exclude": [],
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node", "jsdom"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo"
  }
}
