# Optional: copy to .env to override a default. Every setting has a working default for local
# runs, so no .env is needed. Docker Compose reads PORT and DB_PORT from .env as host ports.

# HTTP server
# HOST=localhost
# PORT=3000
# LOG_LEVEL=info

# Public origin of the app. HTTPS-only security headers (HSTS, upgrade-insecure-requests)
# turn on only when it starts with https://
# PUBLIC_URL=

# Comma-separated IP addresses or subnets of the proxies whose X-Forwarded-For is trusted, such
# as 172.30.0.0/24. Empty: none, and every client counts by its own connection's address.
# TRUST_PROXY=

# Requests one client address may make a minute: to the API as a whole, and to create rooms and
# send messages. A client past a limit gets 429 RATE_LIMITED until the minute is over.
# RATE_LIMIT_API_PER_MINUTE=300
# RATE_LIMIT_ROOMS_PER_MINUTE=30
# RATE_LIMIT_MESSAGES_PER_MINUTE=30

# WebSockets one client address may hold open, and subscriptions each may send a minute.
# SOCKETS_PER_ADDRESS=50
# SUBSCRIPTIONS_PER_MINUTE=60

# MySQL. The defaults match `pnpm db:up`, which publishes MySQL on port 3307.
# DB_HOST=localhost
# DB_PORT=3307
# DB_USER=hello_world
# DB_PASSWORD=hello_world
# DB_NAME=hello_world
# Path to a CA bundle. Setting it turns on TLS to MySQL (used on AWS).
# DB_CA_FILE=
