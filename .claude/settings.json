{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm run *)",
      "Bash(corepack pnpm run *)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec playwright test *)",
      "Bash(docker compose up *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git stash *)",
      "Bash(git hash-object *)",
      "Bash(git update-index *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "PowerShell(pnpm run *)",
      "PowerShell(docker compose up *)",
      "PowerShell(docker compose logs *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git stash *)",
      "PowerShell(git hash-object *)",
      "PowerShell(git update-index *)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git ls-files *)"
    ],
    "ask": [
      "Bash(pnpm add *)",
      "Bash(docker compose down *)",
      "PowerShell(pnpm add *)",
      "PowerShell(docker compose down *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git reset --hard*)",
      "Bash(aws *)",
      "Bash(aws.exe *)",
      "PowerShell(aws *)",
      "PowerShell(aws.exe *)",
      "Bash(gh *)",
      "PowerShell(gh *)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/git-guard.ts\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-file.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-gate.mjs\""
          }
        ]
      }
    ]
  }
}
