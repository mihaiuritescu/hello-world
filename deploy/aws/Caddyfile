# Caddy gets and renews the HTTPS certificate for the site address, redirects HTTP to HTTPS, and
# passes everything to the app, WebSockets included. SITE_ADDRESS is the instance's
# <ip-with-dashes>.sslip.io name, or a real domain.
{$SITE_ADDRESS} {
	encode zstd gzip
	header -Server

	reverse_proxy app:3000 {
		# A redeploy restarts the app; Caddy retries for this long instead of answering 502.
		lb_try_duration 15s
	}
}
