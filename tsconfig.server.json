// The server and repository scripts run as TypeScript directly on Node 24 (type stripping):
// only erasable syntax is allowed, and relative imports keep their .ts extension.
{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["src/server/**/*", "src/shared/**/*", "scripts/**/*"],
  "exclude": ["src/**/*.test.ts", "src/server/test/**"],
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo"
  }
}
